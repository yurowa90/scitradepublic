                "type": "string",
                "enum": [
                  "species",
                  "subspecies",
                  "genus",
                  "family"
                ],
                "description": "대표 학명의 분류 단계: 종·아종·속·과"
              },
              "cites_status": {
                "type": "string",
                "enum": [
                  "listed",
                  "not_listed",
                  "unresolved",
                  "unchecked",
                  "not_applicable"
                ],
                "description": "listed=부속서 등재, not_listed=확인했고 미등재, unresolved=원문끼리 엇갈려 판정 보류, unchecked=확인 안 함(검사 실패), not_applicable=가축·반려 품종으로 해당 없음"
              },
              "cites_checked_on": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "CITES 확인일(YYYY-MM-DD), 확인하지 않았으면 null"
              },
              "cites_basis": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "CITES 등재·미등재·판정 보류의 근거 문장, 확인하지 않았으면 null"
              },
              "iucn_source": {
                "type": "string",
                "enum": [
                  "primary",
                  "secondary"
                ]
              }
